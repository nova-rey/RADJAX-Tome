{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "radjax_tome_payload_shard_index_v1",
  "description": "Schema for each UTF-8 JSONL shard-index record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["shard_id", "path", "sha256", "size_bytes", "first_selection_index", "last_selection_index", "record_count", "semantic_digest"],
  "properties": {
    "shard_id": {"type": "integer", "minimum": 0},
    "path": {"type": "string", "pattern": "^selected_exemplars/shards/[a-z0-9][a-z0-9._-]*\\.jsonl$"},
    "sha256": {"$ref": "#/$defs/sha256"},
    "size_bytes": {"type": "integer", "minimum": 1},
    "first_selection_index": {"type": "integer", "minimum": 0},
    "last_selection_index": {"type": "integer", "minimum": 0},
    "record_count": {"type": "integer", "minimum": 1},
    "semantic_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
