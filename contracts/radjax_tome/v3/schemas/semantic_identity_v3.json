{
  "$id": "radjax_tome_semantic_identity_v3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "behavioral_policy_identity": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "contract_version": {
      "const": "radjax_tome_artifact_contract@3.0.0"
    },
    "ordered_record_sequence_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "record_count": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "schema_version": {
      "const": "radjax_tome_semantic_identity_v3"
    },
    "semantic_authority_identity": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
