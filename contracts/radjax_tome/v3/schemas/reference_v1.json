{
  "$id": "radjax_tome_reference_v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "path": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "pattern": "^[^\\x00\\r\\n]+$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "size_bytes": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "path",
    "sha256",
    "size_bytes",
    "schema_version"
  ],
  "type": "object"
}
