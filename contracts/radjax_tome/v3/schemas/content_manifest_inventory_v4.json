{
  "$id": "tome_content_manifest_inventory_row_v4",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "classification": {
      "enum": [
        "training_critical",
        "integrity_or_provenance",
        "diagnostic",
        "human_readable",
        "operational"
      ]
    },
    "member_role": {
      "enum": [
        "semantic_identity",
        "semantic_authority",
        "behavioral_policy",
        "capabilities",
        "payload_layout",
        "payload_index",
        "payload_shard_index",
        "payload_shard"
      ]
    },
    "path": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "type": "string"
    },
    "required_for_standard_validation": {
      "type": "boolean"
    },
    "sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "size_bytes": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "path",
    "sha256",
    "size_bytes",
    "member_role",
    "classification",
    "required_for_standard_validation"
  ],
  "type": "object"
}
