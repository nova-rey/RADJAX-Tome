{
  "$id": "radjax_tome_archive_receipt_v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm_id": {
      "const": "sha256"
    },
    "archive_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "archive_size_bytes": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "artifact_reference": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[^\\x00\\r\\n]+$",
      "type": "string"
    },
    "schema_version": {
      "const": "radjax_tome_archive_receipt_v1"
    },
    "transport": {
      "enum": [
        "rtome",
        "tgz"
      ]
    }
  },
  "required": [
    "schema_version",
    "algorithm_id",
    "archive_sha256",
    "archive_size_bytes",
    "transport"
  ],
  "type": "object"
}
