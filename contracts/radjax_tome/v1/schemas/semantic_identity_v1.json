{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "radjax_tome_semantic_identity_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "training_payload", "training_contract", "authority", "semantic_digest"],
  "properties": {
    "schema_version": {"const": "radjax_tome_semantic_identity_v1"},
    "training_payload": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_id", "semantic_digest"],
        "properties": {
          "logical_id": {"type": "string", "minLength": 1},
          "semantic_digest": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "training_contract": {"type": "object"},
    "authority": {"type": "object"},
    "semantic_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
