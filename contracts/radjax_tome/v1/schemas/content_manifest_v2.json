{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tome_content_manifest_v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "semantic_identity_digest", "inventory", "manifest_digest"],
  "properties": {
    "schema_version": {"const": "tome_content_manifest_v2"},
    "profile": {"enum": ["unpacked", "student", "full_debug_provenance"]},
    "semantic_identity_digest": {"$ref": "#/$defs/sha256"},
    "inventory": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "manifest_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "classification", "training_authoritative"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "classification": {"enum": ["training_critical", "integrity_or_provenance", "diagnostic", "human_readable", "operational"]},
        "training_authoritative": {"type": "boolean"}
      }
    }
  }
}
