{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radjax.dev/contracts/radjax_tome/student_consumption/v4/schemas/student_consumption_profile_v4.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "profile_id", "base_artifact_identity", "derived_resource_identity", "required_semantic_declarations", "profile_negotiation"],
  "properties": {
    "schema_version": {"const": "radjax_tome_student_consumption_profile_v4"},
    "profile_id": {"const": "native_v3_student_v4"},
    "base_artifact_identity": {"const": "native_v3_semantic_digest"},
    "derived_resource_identity": {"const": "batch_semantic_role_instance_semantic_digest"},
    "required_semantic_declarations": {"const": ["row_range", "delivery_receipt", "authority_reference"]},
    "profile_negotiation": {"const": "explicit_exact_profile_id_no_fallback"},
    "provenance_resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles", "identity_contribution"],
      "properties": {
        "roles": {"const": ["delivery_receipt", "authority_reference"]},
        "identity_contribution": {"const": "integrity_only"}
      }
    }
  }
}
