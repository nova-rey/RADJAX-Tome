{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radjax.dev/contracts/radjax_tome/student_consumption/v2/schemas/tome_cover_v3_student_consumption_v2.json",
  "description": "Closed native-v3 cover family extended with the independently-digested Student-consumption v2 declaration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity", "training", "package", "manifests", "authority", "provenance", "validation", "student_consumption"],
  "properties": {
    "schema_version": {"const": "radjax_tome_cover_v3_student_consumption_v2"},
    "identity": {
      "type": "object",
      "required": ["semantic_digest", "training_payload"],
      "properties": {
        "semantic_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "training_payload": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["logical_id", "semantic_digest"],
            "properties": {
              "logical_id": {"type": "string", "minLength": 1},
              "semantic_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "training": {"type": "object"},
    "package": {
      "type": "object",
      "required": ["transport"],
      "properties": {"transport": {"enum": ["directory", "rtome", "tgz"]}}
    },
    "manifests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content"],
      "properties": {
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "profile", "semantic_identity_digest", "inventory", "manifest_digest"],
          "properties": {
            "schema_version": {"const": "tome_content_manifest_v2"},
            "profile": {"enum": ["unpacked", "student", "full_debug_provenance"]},
            "semantic_identity_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "inventory": {
              "type": "array",
              "items": {"type": "object", "required": ["path", "sha256", "size_bytes", "classification", "training_authoritative"]},
              "contains": {"properties": {"path": {"const": "manifests/student_consumption_v2.json"}}, "required": ["path"]}
            }
          }
        }
      }
    },
    "authority": {"type": "object"},
    "provenance": {"type": "object"},
    "validation": {"type": "object"},
    "student_consumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "manifest_path", "manifest_sha256", "semantic_digest"],
      "properties": {
        "profile_id": {"const": "native_v3_student_v2"},
        "manifest_path": {"const": "manifests/student_consumption_v2.json"},
        "manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "semantic_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "digest_method": {"const": "sha256"},
        "required_capabilities": {"type": "array", "maxItems": 0}
      }
    }
  }
}
