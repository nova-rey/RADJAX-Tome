Screen {
    align: center middle;
}

#wizard-scroll {
    width: 100%;
    height: 1fr;
    padding: 1 2;
}

#title {
    text-style: bold;
    padding: 1 0;
}

#notice, #screens, #status {
    padding: 1 0;
}

Button {
    width: auto;
    margin: 1 0;
}

#actions {
    height: auto;
    width: 100%;
}

#config-editor {
    height: 24;
    min-height: 10;
}

#package-output, #package-profile, #package-transport {
    margin: 1 0;
}
